#!/usr/bin/env python3
import os
import sys
import argparse
import requests
from dotenv import load_dotenv

# Load .env file
# Try current directory, then parent, then project root
possible_env_paths = [
    ".env",
    "../.env",
    "../../.env",
    "/home/mfalero/Projects/Personal/starship-architect/.env"
]
env_loaded = False
for path in possible_env_paths:
    if os.path.exists(path):
        load_dotenv(path)
        env_loaded = True
        break

TAIGA_URL = os.getenv("TAIGA_URL", "https://api.taiga.io").rstrip("/")
TAIGA_USERNAME = os.getenv("TAIGA_USERNAME")
TAIGA_PASSWORD = os.getenv("TAIGA_PASSWORD")
PROJECT_ID = int(os.getenv("TAIGA_PROJECT_ID", "1798624"))

# Color codes
COLOR_RESET = "\033[0m"
COLOR_BOLD = "\033[1m"
COLOR_RED = "\033[31m"
COLOR_GREEN = "\033[32m"
COLOR_YELLOW = "\033[33m"
COLOR_BLUE = "\033[34m"
COLOR_MAGENTA = "\033[35m"
COLOR_CYAN = "\033[36m"
COLOR_WHITE = "\033[37m"

def print_err(msg):
    sys.stderr.write(f"{COLOR_RED}Error: {msg}{COLOR_RESET}\n")

def print_success(msg):
    print(f"{COLOR_GREEN}{msg}{COLOR_RESET}")

def get_auth_token():
    if not TAIGA_USERNAME or not TAIGA_PASSWORD:
        print_err("TAIGA_USERNAME or TAIGA_PASSWORD environment variables not set in .env")
        sys.exit(1)
    
    url = f"{TAIGA_URL}/api/v1/auth"
    payload = {
        "type": "normal",
        "username": TAIGA_USERNAME,
        "password": TAIGA_PASSWORD
    }
    try:
        response = requests.post(url, json=payload, timeout=10)
        response.raise_for_status()
        return response.json().get("auth_token")
    except Exception as e:
        print_err(f"Authentication failed: {e}")
        sys.exit(1)

def get_headers(token):
    return {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json"
    }

def get_user_statuses(headers):
    url = f"{TAIGA_URL}/api/v1/userstory-statuses?project={PROJECT_ID}"
    try:
        response = requests.get(url, headers=headers, timeout=10)
        response.raise_for_status()
        statuses = response.json()
        return {status["id"]: status for status in statuses}
    except Exception as e:
        print_err(f"Failed to fetch userstory statuses: {e}")
        sys.exit(1)

def get_my_user_id(headers):
    url = f"{TAIGA_URL}/api/v1/users/me"
    try:
        response = requests.get(url, headers=headers, timeout=10)
        response.raise_for_status()
        return response.json()
    except Exception as e:
        print_err(f"Failed to fetch user profile: {e}")
        sys.exit(1)

def get_user_story_by_ref(headers, ref):
    url = f"{TAIGA_URL}/api/v1/userstories/by_ref?ref={ref}&project={PROJECT_ID}"
    try:
        response = requests.get(url, headers=headers, timeout=10)
        response.raise_for_status()
        return response.json()
    except Exception as e:
        print_err(f"Failed to fetch user story Ref #{ref}: {e}")
        sys.exit(1)

def list_stories(headers):
    url = f"{TAIGA_URL}/api/v1/userstories?project={PROJECT_ID}"
    try:
        response = requests.get(url, headers=headers, timeout=10)
        response.raise_for_status()
        stories = response.json()
    except Exception as e:
        print_err(f"Failed to list stories: {e}")
        sys.exit(1)
    
    statuses = get_user_statuses(headers)
    
    # Sort stories by status closed state then by Ref
    stories.sort(key=lambda s: (s.get("is_closed", False), s.get("ref", 0)))
    
    # Print table header
    print(f"\n{COLOR_BOLD}{COLOR_WHITE}{'REF':<6} {'STATUS':<15} {'ASSIGNED TO':<20} {'SUBJECT'}{COLOR_RESET}")
    print("-" * 80)
    
    for s in stories:
        ref = f"#{s.get('ref')}"
        status_id = s.get("status")
        status_name = statuses.get(status_id, {}).get("name", "Unknown")
        is_closed = s.get("is_closed", False)
        
        assigned_name = s.get("assigned_to_extra_info", {}).get("full_name_display") if s.get("assigned_to_extra_info") else "Unassigned"
        subject = s.get("subject", "")
        
        # Color status
        if is_closed:
            status_color = COLOR_GREEN
        elif status_name.lower() in ["in progress", "doing", "working"]:
            status_color = COLOR_YELLOW
        else:
            status_color = COLOR_CYAN
            
        print(f"{COLOR_CYAN}{ref:<6}{COLOR_RESET} {status_color}{status_name:<15}{COLOR_RESET} {COLOR_MAGENTA}{assigned_name:<20}{COLOR_RESET} {subject}")
    print()

def create_story(headers, subject, description):
    url = f"{TAIGA_URL}/api/v1/userstories"
    payload = {
        "project": PROJECT_ID,
        "subject": subject,
        "description": description or ""
    }
    try:
        response = requests.post(url, headers=headers, json=payload, timeout=10)
        response.raise_for_status()
        data = response.json()
        print_success(f"Success! Created User Story #{data.get('ref')} - ID: {data.get('id')}")
    except Exception as e:
        print_err(f"Failed to create story: {e}")
        sys.exit(1)

def show_story(headers, ref):
    story = get_user_story_by_ref(headers, ref)
    story_id = story.get("id")
    statuses = get_user_statuses(headers)
    
    status_id = story.get("status")
    status_name = statuses.get(status_id, {}).get("name", "Unknown")
    is_closed = story.get("is_closed", False)
    assigned_name = story.get("assigned_to_extra_info", {}).get("full_name_display") if story.get("assigned_to_extra_info") else "Unassigned"
    
    print(f"\n{COLOR_BOLD}{COLOR_WHITE}User Story #{story.get('ref')}: {story.get('subject')}{COLOR_RESET}")
    print("=" * 80)
    
    status_color = COLOR_GREEN if is_closed else COLOR_CYAN
    print(f"{COLOR_BOLD}Status:{COLOR_RESET} {status_color}{status_name}{COLOR_RESET}")
    print(f"{COLOR_BOLD}Assigned To:{COLOR_RESET} {COLOR_MAGENTA}{assigned_name}{COLOR_RESET}")
    print(f"{COLOR_BOLD}Created By:{COLOR_RESET} {story.get('owner_extra_info', {}).get('full_name_display', 'Unknown')}")
    print(f"{COLOR_BOLD}Created At:{COLOR_RESET} {story.get('created_date')}")
    print("-" * 80)
    print(f"{COLOR_BOLD}Description:{COLOR_RESET}")
    print(story.get("description") or "No description provided.")
    print("-" * 80)
    
    # Fetch and show comments
    history_url = f"{TAIGA_URL}/api/v1/history/userstory/{story_id}"
    try:
        hist_response = requests.get(history_url, headers=headers, timeout=10)
        hist_response.raise_for_status()
        history = hist_response.json()
        
        comments = [h for h in history if h.get("comment")]
        if comments:
            print(f"{COLOR_BOLD}Comments:{COLOR_RESET}")
            for c in reversed(comments):
                user_name = c.get("user", {}).get("name", "Unknown")
                created = c.get("created_at")
                comment_text = c.get("comment")
                print(f"  {COLOR_YELLOW}{user_name}{COLOR_RESET} ({created}):")
                print(f"    {comment_text}")
                print()
        else:
            print("No comments.")
    except Exception as e:
        print_err(f"Failed to fetch history/comments: {e}")
    print()

def update_story_fields(headers, ref, payload_updates, success_msg):
    story = get_user_story_by_ref(headers, ref)
    story_id = story.get("id")
    version = story.get("version")
    
    payload = {
        "version": version
    }
    payload.update(payload_updates)
    
    url = f"{TAIGA_URL}/api/v1/userstories/{story_id}"
    try:
        response = requests.patch(url, headers=headers, json=payload, timeout=10)
        response.raise_for_status()
        print_success(success_msg)
    except Exception as e:
        print_err(f"Failed to update story: {e}")
        sys.exit(1)

def assign_story(headers, ref):
    me = get_my_user_id(headers)
    me_id = me.get("id")
    me_name = me.get("full_name_display")
    
    update_story_fields(
        headers, 
        ref, 
        {"assigned_to": me_id}, 
        f"Success! User Story #{ref} assigned to {me_name}."
    )

def close_story(headers, ref):
    statuses = get_user_statuses(headers)
    
    # Find status with name "Done" or is_closed == True
    done_status_id = None
    done_status_name = "Done"
    for sid, info in statuses.items():
        if info.get("name", "").lower() == "done" or info.get("is_closed"):
            done_status_id = sid
            done_status_name = info.get("name")
            break
            
    if not done_status_id:
        print_err("Could not find a 'Done' or closed status in this project.")
        sys.exit(1)
        
    update_story_fields(
        headers, 
        ref, 
        {"status": done_status_id}, 
        f"Success! User Story #{ref} closed (Status set to {done_status_name})."
    )

def comment_story(headers, ref, comment):
    update_story_fields(
        headers, 
        ref, 
        {"comment": comment}, 
        f"Success! Comment added to User Story #{ref}."
    )

def main():
    parser = argparse.ArgumentParser(description="Custom CLI tool for Taiga.io interaction")
    subparsers = parser.add_subparsers(dest="command", help="Subcommand to execute")
    
    # list
    subparsers.add_parser("list", aliases=["ls"], help="List user stories")
    
    # create
    create_parser = subparsers.add_parser("create", aliases=["new"], help="Create a user story")
    create_parser.add_argument("subject", help="Subject of the user story")
    create_parser.add_argument("description", nargs="?", default="", help="Description of the user story")
    
    # show
    show_parser = subparsers.add_parser("show", aliases=["view"], help="View details of a user story")
    show_parser.add_argument("ref", type=int, help="Reference number of the user story (e.g. 23)")
    
    # assign
    assign_parser = subparsers.add_parser("assign", help="Assign user story to yourself")
    assign_parser.add_argument("ref", type=int, help="Reference number of the user story")
    
    # close
    close_parser = subparsers.add_parser("close", aliases=["done"], help="Close a user story")
    close_parser.add_argument("ref", type=int, help="Reference number of the user story")
    
    # comment
    comment_parser = subparsers.add_parser("comment", help="Add a comment to a user story")
    comment_parser.add_argument("ref", type=int, help="Reference number of the user story")
    comment_parser.add_argument("message", help="Comment message")
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        sys.exit(1)
        
    token = get_auth_token()
    headers = get_headers(token)
    
    if args.command in ["list", "ls"]:
        list_stories(headers)
    elif args.command in ["create", "new"]:
        create_story(headers, args.subject, args.description)
    elif args.command in ["show", "view"]:
        show_story(headers, args.ref)
    elif args.command in ["assign"]:
        assign_story(headers, args.ref)
    elif args.command in ["close", "done"]:
        close_story(headers, args.ref)
    elif args.command in ["comment"]:
        comment_story(headers, args.ref, args.message)

if __name__ == "__main__":
    main()
